# systemd-service: start het BusDash-dashboard automatisch bij het opstarten van de Pi.
#
# Eerst één keer een gebruiker aanmaken (als dezelfde gebruiker als User= hieronder):
#   java -jar /home/ortzadarra/busdash-edge-0.1.0-SNAPSHOT.jar --set-password <naam>
#
# Installeren:
#   sudo cp busdash-edge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now busdash-edge
# Logs bekijken:
#   journalctl -u busdash-edge -f
#
# Pas User, het pad naar de jar en de twee poorten aan. De vaste poortnamen vind je met:
#   ls /dev/serial/by-id/
# (twee VE.Direct-kabels: aan het serienummer zie je welke bij de BMV en welke bij de MPPT hoort)

[Unit]
Description=BusDash edge - dashboard voor accu, zon en relais
After=network-online.target
Wants=network-online.target

[Service]
User=ortzadarra
# dialout: seriële poorten (BMV en MPPT), gpio: relaisbord
SupplementaryGroups=dialout gpio
ExecStart=/usr/bin/java -jar /home/ortzadarra/busdash-edge-0.1.0-SNAPSHOT.jar --dashboard \
    --bmv-port /dev/serial/by-id/usb-VictronEnergy_BV_VE_Direct_cable_VE5P3H1G-if00-port0 \
    --mppt-port /dev/serial/by-id/usb-VictronEnergy_BV_VE_Direct_cable_VEBFVMK0-if00-port0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
